#include <iostream>
#include <cmath>

int main() {
    double h, ay;

    std::cout << "Введите вертикальное ускорение ay (м/с²): ";
    std::cin >> ay;
    std::cout << "Введите высоту набора h (м): ";
    std::cin >> h;

    if (ay <= 0 || h <= 0) {
        std::cout << "Ошибка: ускорение и высота должны быть строго больше 0!" << std::endl;
        return 1;
    }

    double t = std::sqrt((2.0 * h) / ay);

    std::cout << "Время набора заданной высоты t = " << t << " с" << std::endl;
    return 0;
}
