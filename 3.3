
#include <iostream>
#include <vector>
#include <iomanip>
#include <cmath>

int main() {
    double v0 = 50.0, g = 9.8, dt = 1.0;
    double t_max = std::ceil(2 * v0 / g);   

    std::vector<double> times, velocities;
    for (double t = 0.0; t <= t_max; t += dt) {
        double v = v0 - g * t;
        times.push_back(t);
        velocities.push_back(v);
    }

    std::cout << std::setw(10) << "t (s)" << std::setw(15) << "v (m/s)" << "\n";
    std::cout << std::string(25, '-') << "\n";
    for (size_t i = 0; i < times.size(); ++i) {
        std::cout << std::setw(10) << std::fixed << std::setprecision(2) << times[i]
                  << std::setw(15) << velocities[i] << "\n";
    }

    std::cout << "Скорость меняет знак при t = v0/g = " << v0 / g << " с\n";
    return 0;
}
