#include <iostream>
#include <iomanip>

class Engine {
private:
    double thrust;
    double fuelFlow;
    double fuel;

public:
    Engine(double T, double flow, double f) : thrust(T), fuelFlow(flow), fuel(f) {}

    double getThrust() const { return thrust; }
    double getFuel() const { return fuel; }
    bool hasFuel() const { return fuel > 0; }

    void burn(double dt) {
        if (hasFuel()) {
            fuel -= fuelFlow * dt;
            if (fuel < 0) fuel = 0;
        }
    }
};

class Navigation {
private:
    double altitude;
    double velocity;
    double acceleration;
    double mass;

public:
    Navigation(double h, double v, double m)
        : altitude(h), velocity(v), acceleration(0), mass(m) {}

    double getAltitude() const { return altitude; }

    void update(double thrust, double dt) {
        acceleration = thrust / mass - 9.81;
        altitude += velocity * dt;
        velocity += acceleration * dt;
    }

    void printStatus(double time) const {
        std::cout << std::fixed << std::setprecision(2);
        std::cout << "t=" << time << "с | h=" << altitude << "м | v=" << velocity
                  << "м/с | a=" << acceleration << "м/с²\n";
    }
};

class AutonomousFlightSystem {
private:
    Engine engine;
    Navigation nav;
    double time;

public:
    AutonomousFlightSystem(const Engine& e, const Navigation& n) : engine(e), nav(n), time(0) {}

    void simulate(double dt, double totalTime) {
        while (time < totalTime && engine.hasFuel()) {
            engine.burn(dt);
            nav.update(engine.getThrust(), dt);
            nav.printStatus(time);
            time += dt;
        }
    }

    void printSummary() const {
        std::cout << "--- Полет завершен ---\n";
        std::cout << std::defaultfloat << std::setprecision(6);
        std::cout << "Итоговая высота: " << nav.getAltitude() << " м\n";
        std::cout << "Оставшееся топливо: " << engine.getFuel() << " кг\n";
    }
};

int main() {
    Engine engine(20000, 10, 50);
    Navigation nav(0, 0, 1000);
    AutonomousFlightSystem system(engine, nav);

    system.simulate(1.0, 10.0);
    system.printSummary();
    return 0;
}
