#include <iostream>
#include <iomanip>

class Engine {
private:
    double thrust;
    double fuelFlow;
    
public:
    Engine(double T, double F) : thrust(T), fuelFlow(F) {}

    double getSpecificImpulse() const { return thrust / (fuelFlow * 9.81); }

    void printInfo() const {
        std::cout << "Тяга: " << thrust << " Н | Расход: " << fuelFlow
                  << " кг/с | Удельный импульс: "
                  << std::fixed << std::setprecision(2) << getSpecificImpulse() << " с\n";
    }
};

int main() {
    Engine e1(5000, 2.5);
    e1.printInfo();
    return 0;
}
