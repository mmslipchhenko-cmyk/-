#include <iostream>
#include <vector>
#include <algorithm>
#include <iomanip>
using namespace std;

int main() {
    const double v0 = 50.0, g = 9.8, dt = 1.0;
    vector<double> times, heights;

   
    for (double t = 0.0; t <= 12; t += dt) {
        times.push_back(t);
        heights.push_back(v0 * t - 0.5 * g * t * t);
    }

   
    auto it = find_if(heights.begin() + 1, heights.end(),
                      [](double h) { return h <= 0.0; });

    if (it == heights.end()) {
        cout << "Падения в этом диапазоне не было" << endl;
    } else {
        size_t idx = distance(heights.begin(), it);
        cout << fixed << setprecision(2);
        cout << "t_fall = " << times[idx] << " с, h = " << heights[idx] << " м" << endl;
    }

    return 0;
}
